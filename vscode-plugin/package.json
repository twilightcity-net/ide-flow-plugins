{
    "name": "flowinsight",
    "displayName": "FlowInsight Metrics",
    "description": "Capture automated Flow activity from your developer experience as you navigate around the code, modify code, and execute tests.",
    "version": "0.1.0",
    "publisher": "twilightcity",
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "*"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "flowinsight.uploadFlow",
                "title": "Upload to FlowInsight",
                "icon": "$(cloud-upload)"
            },
            {
                "command": "flowinsight.registerFervieAction",
                "title": "Register a Fervie Action"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "flowinsight.uploadFlow",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile",
        "test": "node ./out/test/runTest.js",
        "test:unit": "mocha --require ts-node/register 'src/test/suite/**/*.test.ts'",
        "test:integration": "node ./out/test/runTest.js",
        "coverage": "nyc npm run test:unit"
    },
    "devDependencies": {
        "@types/vscode": "^1.60.0",
        "@types/node": "^14.14.37",
        "typescript": "^4.3.5",
        "@types/mocha": "^8.2.2",
        "@types/glob": "^7.1.3",
        "@vscode/test-electron": "^1.6.2",
        "mocha": "^8.4.0",
        "glob": "^7.1.7"
    },
    "dependencies": {
        "date-fns": "^2.23.0"
    }
} 